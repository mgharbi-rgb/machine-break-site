      - { url: /machines/bianchi-agily, name: Grand écran, d: "21 pouces, jusqu'à 1 100 gobelets", img: /assets/img/machines/bianchi-agily-640.webp, alt: Distributeur de boissons chaudes à grand écran, w: 407, h: 640 }
