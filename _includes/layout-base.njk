<!DOCTYPE html>
<html lang="fr" class="no-js">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | Machine Break</title>
  <meta name="description" content="{{ description }}">
  {%- if noindex %}
  <meta name="robots" content="noindex, nofollow">
  {%- else %}
  <link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
  {%- endif %}
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <meta name="theme-color" content="#753F48">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:locale" content="fr_FR">
  <meta property="og:site_name" content="Machine Break">
  <meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
  <meta property="og:title" content="{{ title }} | Machine Break">
  <meta property="og:description" content="{{ description }}">
  <meta property="og:image" content="{{ site.url }}{{ image or '/assets/img/og-image.jpg' }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ title }} | Machine Break">
  <meta name="twitter:description" content="{{ description }}">
  <meta name="twitter:image" content="{{ site.url }}{{ image or '/assets/img/og-image.jpg' }}">
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/HK Grotesk Pro/HKGroteskPro-Regular.woff2" crossorigin>
  <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/Big Shoulders Stencil Display/BigShouldersStencilDisplay-latin.woff2" crossorigin>
  {%- if preload %}
  <link rel="preload" as="image" href="{{ preload }}" fetchpriority="high">
  {%- endif %}
  <link rel="stylesheet" href="/assets/css/mb.css?v={{ site.buildDate }}">
  <script type="application/ld+json">{{ ld.organisation | dump | safe }}</script>
  {%- if jsonld %}
  <script type="application/ld+json">{{ jsonld | safe }}</script>
  {%- endif %}
  {%- if faq %}
  <script type="application/ld+json">{{ faq | faqLd | safe }}</script>
  {%- endif %}
  {%- if crumbs %}
  <script type="application/ld+json">{{ crumbs | crumbsLd | safe }}</script>
  {%- endif %}
{% block head %}{% endblock %}</head>
<body>
{% include "header-mb.html" %}
<main id="contenu">
{{ content | safe }}
</main>
{% include "footer-mb.html" %}
</body>
</html>
