---
layout: layout-base.njk
ogType: article
---
<article>
  <div class="page-hero light"><div class="wrap">
    <nav class="crumbs" aria-label="Fil d'Ariane"><ol><li><a href="/">Accueil</a></li><li><a href="/blog">Conseils</a></li><li>{{ kicker or "Article" }}</li></ol></nav>
    <h1><span class="k">{{ kicker or "Article" }} · <time datetime="{{ date | isoDate }}">{{ date | frDate }}</time></span>{{ title }}</h1>
    <p class="intro">{{ description }}</p>
  </div></div>
  <div class="wrap"><div class="prose" style="padding-top:2.5rem">
    {% if image %}<img src="{{ image }}" alt="{{ image_alt }}" loading="lazy">{% endif %}
    {{ content | safe }}
    <p style="margin-top:2.5rem"><a class="btn btn-plain" href="/blog">← Tous les conseils</a></p>
  </div></div>
  <script type="application/ld+json">{{ page | articleLd(title, description, image, date, updated) | safe }}</script>
</article>
