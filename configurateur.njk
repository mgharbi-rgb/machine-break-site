---
layout: layout-base.njk
permalink: /configurateur.html
title: Quelle machine pour votre site ? Le configurateur
description: "Effectif, salles de pause, boissons fraîches ou non : en trois questions, visualisez la machine à café ou le distributeur adapté à votre site en Île-de-France, et le loyer à partir duquel elle se loue."
crumbs:
  - { name: Accueil, url: / }
  - { name: Configurateur, url: /configurateur }
noCta: true
---
<div class="page-hero light"><div class="wrap">
  {% include "crumbs.html" %}
  <h1><span class="k">Configurateur</span>Quelle machine pour votre site ?</h1>
  <p class="intro">Trois questions, et vous visualisez la machine qu'il vous faut, salle par salle, avec la formule et le loyer à partir duquel elle se loue. C'est une première recommandation : la visite de votre site la confirme ou l'ajuste.</p>
</div></div>

<section style="padding-top:2.5rem"><div class="wrap cfg" id="cfg">
  <form class="fform cfg-form" id="cfg-form" onsubmit="return false">
    <fieldset><legend class="k">1 · Votre site</legend>
      <label for="c-type">Type de site</label>
      <select id="c-type"><option value="bureau">Bureaux, PME, siège</option><option value="industrie">Industrie, logistique, atelier</option><option value="residence">Résidence, hôtel, hébergement</option><option value="public">Hall, école, établissement de santé, lieu de passage</option></select>
      <label for="c-people">Personnes présentes sur le site un jour normal</label>
      <input type="number" id="c-people" min="5" max="5000" step="5" value="60" inputmode="numeric">
    </fieldset>
    <fieldset><legend class="k">2 · Vos pauses</legend>
      <label for="c-rooms">Salles de pause ou points de service à équiper</label>
      <input type="number" id="c-rooms" min="1" max="20" value="1" inputmode="numeric">
      <label for="c-drinks">Boissons chaudes par jour sur le site <small>(calculé, modifiable)</small></label>
      <input type="number" id="c-drinks" min="10" max="20000" step="10" inputmode="numeric">
      <p class="note" id="c-hyp" style="margin:-.4rem 0 1rem"></p>
    </fieldset>
    <fieldset><legend class="k">3 · En plus du café</legend>
      <label style="display:flex;gap:.7rem;align-items:center;font-weight:400"><input type="checkbox" id="c-frais" style="width:auto;min-height:0;margin:0"><span>Boissons fraîches et snacks</span></label>
      <label style="display:flex;gap:.7rem;align-items:center;font-weight:400"><input type="checkbox" id="c-multi" style="width:auto;min-height:0;margin:0"><span>Plusieurs sites à équiper</span></label>
    </fieldset>
  </form>

  <div class="cfg-result" id="cfg-result" aria-live="polite">
    <p class="k">Notre recommandation</p>
    <div id="cfg-machines"></div>
    <div class="cfg-formule" id="cfg-formule"></div>
    <div class="act-row"><a class="btn btn-mb cta-diagnostic" id="cfg-cta" href="/contact#contact-form">Recevoir cette recommandation</a><span>Le formulaire d'une minute reprend votre configuration ; rappel sous 24 h.</span></div>
    <p class="note" style="margin-top:1.2rem">Hypothèses affichées ci-contre, capacités selon les données constructeur de chaque fiche. Loyers en euros HT par mois, entretien et dépannage compris, consommations non comprises. La visite du site précède toute proposition.</p>
  </div>
</div></section>

<script>
(function () {
  // Règles de dimensionnement : capacités constructeur (fiches machines) et loyers (_data/prix.json). Les hypothèses sont visibles et modifiables par le visiteur.
  var PRIX = {{ prix.location | dump | safe }};
  var PAR_PERSONNE = { bureau: 1.5, industrie: 2, residence: 0.8, public: 1 }; // boissons chaudes par personne et par jour
  var CAFE = [
    { slug: 'animo-optivend-21s', nom: 'La petite', type: 'Machine à boissons solubles', max: 60, img: '', url: '/contact?interet=cafe#contact-form', d: 'Pour les petites équipes.' },
    { slug: 'animo-optime-x', nom: 'La compacte', type: 'Machine à café en grains', max: 125, img: '/assets/img/machines/animo-optime-x-640.webp', url: '/machines/animo-optime-x', d: '38 cm de large, jusqu\'à 125 boissons par jour.' },
    { slug: 'animo-optibean-x', nom: 'La grande', type: 'Machine à café en grains', max: 250, img: '/assets/img/machines/animo-optibean-x-640.webp', url: '/machines/animo-optibean-x', d: 'Espresso et café filtre, jusqu\'à 250 boissons par jour.' },
    { slug: 'bianchi-agily', nom: 'Grand écran', type: 'Distributeur de boissons chaudes', max: 500, img: '/assets/img/machines/bianchi-agily-640.webp', url: '/machines/bianchi-agily', d: 'Écran 21 pouces, jusqu\'à 1 100 gobelets en réserve.' },
    { slug: 'bianchi-intuity', nom: 'Très grande capacité', type: 'Distributeur de boissons chaudes', max: 1e9, img: '/assets/img/machines/bianchi-intuity-640.webp', url: '/machines/bianchi-intuity', d: 'Écran 32 pouces, double chaudière, jusqu\'à 1 560 gobelets.' }
  ];
  var FRAIS = { slug: 'sielaff-siline', nom: 'Snacks et frais', type: 'Distributeur de snacks et boissons fraîches', img: '/assets/img/machines/sielaff-siline-640.webp', url: '/machines/sielaff-siline', d: 'Deux zones de température, livraison par ascenseur.' };
  var FRAIS_GRAND = { slug: 'sielaff-robimat', nom: 'Boissons fraîches grande capacité', type: 'Distributeur de boissons fraîches', img: '/assets/img/machines/sielaff-robimat-640.webp', url: '/machines/sielaff-robimat', d: 'Vitrine panoramique, jusqu\'à 770 bouteilles.' };
  var $ = function (id) { return document.getElementById(id); };
  var type = $('c-type'), people = $('c-people'), rooms = $('c-rooms'), drinks = $('c-drinks'), frais = $('c-frais'), multi = $('c-multi'), touched = false;
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function eur(n) { return n.toLocaleString('fr-FR') + ' € HT/mois'; }
  function card(m, n) {
    return '<article class="cfg-card">' + (m.img ? '<img src="' + m.img + '" alt="" width="200" height="300" loading="lazy">' : '<div class="cfg-noimg" aria-hidden="true">?</div>') +
      '<div><span class="k">' + esc(m.type) + '</span><h3>' + (n > 1 ? n + ' × ' : '') + esc(m.nom) + '</h3><p>' + esc(m.d) + '</p>' +
      (PRIX[m.slug] ? '<p class="price"><b>' + eur(PRIX[m.slug] * n) + '</b>' + (n > 1 ? ' pour ' + n + ' machines' : '') + ' en location</p>' : '') +
      (m.url.indexOf('/machines/') === 0 ? '<a class="more" href="' + m.url + '">Voir la fiche →</a>' : '') + '</div></article>';
  }
  function upd() {
    var t = type.value, p = Math.max(5, +people.value || 0), r = Math.max(1, +rooms.value || 1);
    if (!touched) drinks.value = Math.round(p * PAR_PERSONNE[t] / 10) * 10 || 10;
    var d = Math.max(10, +drinks.value || 10), perRoom = Math.ceil(d / r);
    $('c-hyp').textContent = 'Hypothèse : ' + PAR_PERSONNE[t] + ' boisson' + (PAR_PERSONNE[t] > 1 ? 's' : '') + ' chaude' + (PAR_PERSONNE[t] > 1 ? 's' : '') + ' par personne et par jour, réparties sur ' + r + ' point' + (r > 1 ? 's' : '') + ' de service, soit environ ' + perRoom + ' par point.';
    var m = CAFE[0];
    for (var i = 0; i < CAFE.length; i++) { if (perRoom <= CAFE[i].max) { m = CAFE[i]; break; } }
    if ((t === 'industrie' || t === 'public') && (m.slug === 'animo-optime-x' || m.slug === 'animo-optibean-x') && perRoom > 80) m = CAFE[3];
    var html = card(m, r), total = (PRIX[m.slug] || 0) * r, list = [r + ' × ' + m.nom + ' (' + m.type + ')'];
    if (frais.checked) { var f = (t === 'industrie' || perRoom > 200) ? FRAIS_GRAND : FRAIS; html += card(f, r); total += (PRIX[f.slug] || 0) * r; list.push(r + ' × ' + f.nom); }
    $('c-machines' === '' ? '' : 'cfg-machines').innerHTML = html;
    var depot = p >= {{ prix.depot_seuil }};
    $('cfg-formule').innerHTML = depot
      ? '<h3>Formule conseillée : le dépôt</h3><p>Avec ' + p + ' personnes sur le site, l\'installation, la mise en service, le réassort et l\'entretien sont offerts : vous ne payez que les consommations. La location reste possible' + (total ? ', à partir de ' + eur(total) : '') + '.</p>'
      : '<h3>Formule conseillée : la location</h3><p>Loyer mensuel fixe, entretien et dépannage compris' + (total ? ' : <b>à partir de ' + eur(total) + '</b>' : '') + ', hors consommations. L\'achat avec contrat de maintenance est aussi possible. Le dépôt s\'étudie au cas par cas en dessous de {{ prix.depot_seuil }} personnes.</p>';
    if (multi.checked) $('cfg-formule').innerHTML += '<p>Plusieurs sites : un interlocuteur nommé et un reporting consolidé, <a href="/grands-comptes">voir grands comptes</a>.</p>';
    var resume = 'Configurateur : site ' + type.options[type.selectedIndex].text + ', ' + p + ' personnes, ' + r + ' point(s) de service, ' + d + ' boissons chaudes/jour' + (frais.checked ? ', boissons fraîches et snacks' : '') + (multi.checked ? ', plusieurs sites' : '') + '. Recommandation : ' + list.join(' + ') + ', formule ' + (depot ? 'dépôt' : 'location') + (total ? ' (à partir de ' + eur(total) + ')' : '') + '.';
    $('cfg-cta').href = '/contact?interet=' + (frais.checked ? 'plusieurs' : (m.type.indexOf('café') > -1 || m.type.indexOf('solubles') > -1 ? 'cafe' : 'chaud')) + '&config=' + encodeURIComponent(resume) + '#contact-form';
  }
  [type, people, rooms, frais, multi].forEach(function (el) { el.addEventListener('input', upd); el.addEventListener('change', upd); });
  drinks.addEventListener('input', function () { touched = true; upd(); });
  type.addEventListener('change', function () { touched = false; }); people.addEventListener('input', function () { touched = false; });
  upd();
})();
</script>
